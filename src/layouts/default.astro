---
/**
 * Default layout — used by every non-home page (book, chapter,
 * about). Wraps everything in a `.sheet` container with the
 * blueprint double border, and renders the sheet header
 * (brand + nav) and the sheet footer (title block + theme
 * picker) as encapsulated components.
 */
import SheetFooter from "../components/sheet-footer.astro";
import SheetHeader from "../components/sheet-header.astro";
import { DEFAULT_THEME, STORAGE_KEY, themes } from "../lib/themes";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** slug de un tema en `src/config.json` */
  theme?: string;
  lang?: string;
}

const {
  title,
  description = "",
  theme = DEFAULT_THEME,
  lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={theme} class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator}>
    <!--
      `color-scheme` is also set per-theme in `global.css` so the UA
      picks the right form-control palette when a light Glance theme
      is active. Keep this as `light dark` (auto) — the CSS rule wins.
    -->
    <meta name="color-scheme" content="light dark">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <!--
      Per-theme CSS (~5 KB, cached): --color-*/--font-mono variables
      for each theme. Generated by `tools/generate-theme-css.mjs`
      from `src/config.json`.
    -->
    <link rel="stylesheet" href="/theme.css">
    <title>{title}</title>
    <meta name="description" content={description}>
    <!--
      SEO slot: canonical, Open Graph, Twitter Card, RSS autodiscovery
      and JSON-LD. Each page passes its own <Seo schemaType="..." />
      via <Fragment slot="seo">.
    -->
    <slot name="seo" />
    <!--
      Anti-FOUC: applies the stored theme before first paint. The
      external theme.css is render-blocking, so when it loads the
      matching [data-theme="..."] rules will style the page correctly.
    -->
    <script is:inline define:vars={{ themes, storageKey: STORAGE_KEY }}>
      const stored = localStorage.getItem(storageKey);
      if (stored && themes.includes(stored)) {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body
    class="min-h-screen font-mono text-sm sm:text-base leading-normal text-fg antialiased selection:bg-accent selection:text-bg"
  >
    <main class="sheet">
      <SheetHeader />
      <slot />
      <SheetFooter />
    </main>
  </body>
</html>
