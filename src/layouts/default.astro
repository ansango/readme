---
/**
 * Default layout — used by every non-home page (book, chapter, about).
 *
 * Wraps everything in a `.sheet` container with the blueprint
 * double border, and renders the new sheet header (brand + nav)
 * and footer (title block + theme picker). The theme picker stays
 * in the footer (per the design decision) and is rendered by
 * `<ThemePicker />`.
 */
import ThemePicker from "../components/theme-picker.astro";
import TitleBlock from "../components/title-block.astro";
import { DEFAULT_THEME, STORAGE_KEY, themes } from "../lib/themes";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** slug de un tema en `src/config.json` */
  theme?: string;
  lang?: string;
}

const {
  title,
  description = "",
  theme = DEFAULT_THEME,
  lang = "es",
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isAbout = pathname.startsWith("/about");

/**
 * SHEET value for the title block, derived from the URL depth:
 *   /<book-slug>/         → "02 / 03"  (book index)
 *   /<book-slug>/<cap>/   → "03 / 03"  (chapter)
 *   anything deeper       → "03 / 03"  (fallback)
 * The home layout (home.astro) passes "01 / 03" itself.
 */
const segments = pathname.split("/").filter(Boolean).length;
const sheet =
  segments <= 0 ? "01 / 03" : segments === 1 ? "02 / 03" : "03 / 03";
---

<!doctype html>
<html lang={lang} data-theme={theme} class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator}>
    <!--
      `color-scheme` is also set per-theme in `global.css` so the UA
      picks the right form-control palette when a light Glance theme
      is active. Keep this as `light dark` (auto) — the CSS rule wins.
    -->
    <meta name="color-scheme" content="light dark">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <!--
      Per-theme CSS (~5 KB, cached): --color-*/--font-mono variables
      for each theme. Generated by `tools/generate-theme-css.mjs`
      from `src/config.json`.
    -->
    <link rel="stylesheet" href="/theme.css">
    <title>{title}</title>
    <meta name="description" content={description}>
    <!--
      SEO slot: canonical, Open Graph, Twitter Card, RSS autodiscovery
      and JSON-LD. Each page passes its own <Seo schemaType="..." />
      via <Fragment slot="seo">.
    -->
    <slot name="seo" />
    <!--
      Anti-FOUC: applies the stored theme before first paint. The
      external theme.css is render-blocking, so when it loads the
      matching [data-theme="..."] rules will style the page correctly.
    -->
    <script is:inline define:vars={{ themes, storageKey: STORAGE_KEY }}>
      const stored = localStorage.getItem(storageKey);
      if (stored && themes.includes(stored)) {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body
    class="min-h-screen font-mono text-sm sm:text-base leading-normal text-fg antialiased selection:bg-accent selection:text-bg"
  >
    <main class="sheet">
      <!-- ── header ───────────────────────────────────────── -->
      <header class="sheet-header">
        <div class="sheet-brand">README <em>by ansango</em></div>
        <nav class="sheet-nav" aria-label="principal">
          <a href="/" class:list={[{ active: isHome }]}>home</a>
          <a href="/about" class:list={[{ active: isAbout }]}>about</a>
        </nav>
      </header>

      <!-- ── body ──────────────────────────────────────────── -->
      <slot />

      <!-- ── footer ────────────────────────────────────────── -->
      <footer class="sheet-footer">
        <TitleBlock sheet={sheet} />
        <div
          class="flex flex-wrap items-center justify-end gap-2 text-[0.85rem]"
        >
          <ThemePicker />
        </div>
      </footer>
    </main>
  </body>
</html>
