---
import Layout from "./default.astro";

interface Props {
  title: string;
  description?: string;
}

// Las páginas `.md` reciben el frontmatter vía `Astro.props.frontmatter`.
// Usamos ese cuando existe (camino del about.md actual) y caemos a
// `Astro.props` por si en el futuro se invoca este layout desde un .astro.
const fm = "frontmatter" in Astro.props ? Astro.props.frontmatter : Astro.props;
const { title, description } = fm;
---

<Layout title={title} description={description}>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <a href="/" class="text-sm text-accent hover:underline">← Home</a>
      <h1
        id="about"
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {title}
      </h1>
      {description && (
				<p class="mt-2 text-sm text-dim md:text-base">
					{description}
				</p>
			)}
    </header>

    <slot />
  </article>
</Layout>
