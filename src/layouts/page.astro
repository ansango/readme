---
import Layout from "./default.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
}

const { id, title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <a href="/" class="text-sm text-accent hover:underline">← Home</a>
      <h1
        id={id}
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {title}
      </h1>
      {description && (
				<p class="mt-2 text-sm text-dim md:text-base">
					{description}
				</p>
			)}
    </header>

    <slot />
  </article>
</Layout>
