---
// Redirect legacy /capitulos/<id>/ → /linux-para-hackers/<id>/.
//
// Se implementa como página estática (no en `astro.config.ts → redirects`)
// porque ese mecanismo no puede transformar un rest param `[...slug]`
// en una ruta con params con nombre distinto (`/[book]/[chapter]`).
//
// Cloudflare (public/_redirects) emite 301 en el edge antes de servir
// esta página. En build/dev Astro genera un HTML con meta refresh al
// destino. `getStaticPaths` enumera los capítulos conocidos porque en
// output estático no se puede responder a paths arbitrarios.
import { getCollection } from "astro:content";
import type { Chapter, ChapterData } from "../../content.config";
import { chapterIdFromId } from "../../lib/book-slug";

export async function getStaticPaths() {
  const chapters = (await getCollection(
    "chapters",
    ({ data }: { data: ChapterData }) => !data.draft,
  )) as Chapter[];

  return chapters
    .map((c) => {
      const id = chapterIdFromId(c.id);
      return id && !id.startsWith("00-") ? { params: { slug: id } } : null;
    })
    .filter((x): x is { params: { slug: string } } => x !== null);
}

const { slug } = Astro.params;
return Astro.redirect(`/linux-para-hackers/${slug}/`, 301);
---

