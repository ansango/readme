---
import { getCollection } from "astro:content";
import ChapterList from "../../components/chapter-list.astro";
import Layout from "../../layouts/default.astro";

const chapters = await getCollection("chapters", ({ data }) => !data.draft);
const total = chapters.length;
---

<Layout
  title="Capítulos · Linux Basics for Hackers"
  description={`Índice de los ${total} capítulos.`}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-8 border-b border-dim pb-6">
      <a href="/" class="text-sm text-accent hover:underline"> ← Inicio </a>
      <h1 class="mt-4 font-mono text-2xl font-medium md:text-3xl">Capítulos</h1>
      <p class="mt-2 text-sm text-dim md:text-base">
        Listado completo de los
        <span class="text-accent">{total}</span> capítulos.
      </p>
    </header>

    <ChapterList />
  </div>
</Layout>
