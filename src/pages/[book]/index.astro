---
import { getCollection, render } from "astro:content";
import type { Chapter, ChapterData } from "../../content.config";
import Layout from "../../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../../lib/book-slug";
import { formatReadingTime, readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const chapters = (await getCollection(
    "chapters",
    ({ data }: { data: ChapterData }) => !data.draft,
  )) as Chapter[];

  // Por cada libro nos quedamos con su capítulo "00-..." (índice) y
  // todos sus capítulos para calcular el tiempo de lectura total.
  const bookChapters = new Map<string, Chapter[]>();
  for (const c of chapters) {
    const book = bookSlugFromId(c.id);
    if (!book) continue;
    if (!bookChapters.has(book)) bookChapters.set(book, []);
    bookChapters.get(book)?.push(c);
  }

  const result: Array<{
    params: { book: string };
    props: { book: string; indexChapter: Chapter; allChapters: Chapter[] };
  }> = [];

  for (const [book, list] of bookChapters) {
    const indexChapter = list.find((c) => {
      const id = chapterIdFromId(c.id);
      return id && id.startsWith("00-");
    });
    if (!indexChapter) continue;
    result.push({
      params: { book },
      props: { book, indexChapter, allChapters: list },
    });
  }

  return result;
}

interface Props {
  book: string;
  indexChapter: Chapter;
  allChapters: Chapter[];
}

const { book, indexChapter, allChapters } = Astro.props;
const { Content } = await render(indexChapter);

// Solo los capítulos numerados (01-…) cuentan para el tiempo total;
// el 00- es el índice que estás viendo y ya está fuera de la lectura.
const numberedChapters = allChapters.filter((c) => {
  const id = chapterIdFromId(c.id);
  return id && !id.startsWith("00-");
});
const totalMinutes = numberedChapters.reduce((acc, c) => {
  const { minutes } = readingTime(c.body ?? "");
  return acc + minutes;
}, 0);
---

<Layout
  title={indexChapter.data.title}
  description={indexChapter.data.description}
>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <a href="/" class="text-sm text-accent hover:underline">← Libros</a>
      <h1
        id={book}
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {indexChapter.data.title}
      </h1>

      <p class="mt-1 text-sm text-dim md:text-base">
        {indexChapter.data.description}
      </p>

      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-dim"
      >
        <span>
          {numberedChapters.length}
          {numberedChapters.length === 1 ? " capítulo" : " capítulos"}
        </span>
        <span>{formatReadingTime(totalMinutes)} de lectura</span>
      </div>
    </header>

    <Content />
  </article>
</Layout>
