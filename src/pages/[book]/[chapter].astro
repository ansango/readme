---
import { getCollection, render } from "astro:content";
import type { Chapter, ChapterData } from "../../content.config";
import Layout from "../../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../../lib/book-slug";

export async function getStaticPaths() {
  const chapters = (await getCollection(
    "chapters",
    ({ data }: { data: ChapterData }) => !data.draft,
  )) as Chapter[];

  // El "00-..." actúa como índice del libro y vive en /{book}/, no
  // aquí. El resto de capítulos sí tienen su propia URL.
  return chapters
    .filter((c) => {
      const id = chapterIdFromId(c.id);
      return id && !id.startsWith("00-");
    })
    .map((c) => ({
      params: {
        book: bookSlugFromId(c.id),
        chapter: chapterIdFromId(c.id),
      },
      props: { chapter: c },
    }));
}

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const formatDate = (d: Date) =>
  d.toLocaleDateString("es-ES", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---

<Layout title={chapter.data.title} description={chapter.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-10 prose">
    <header class="mb-8 border-b border-dim pb-6">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-sm text-accent hover:underline"
        aria-label="Volver al inicio del libro"
      >
        ← Volver al libro
      </a>
      <h1
        id={chapterIdFromId(chapter.id)}
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {chapter.data.title}
      </h1>
      {chapter.data.description && (
        <p class="mt-2 text-sm text-dim md:text-base">{chapter.data.description}</p>
      )}
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-dim"
      >
        <time datetime={chapter.data.date.toISOString()}>
          {formatDate(chapter.data.date)}
        </time>
        {chapter.data.date.getTime() !== chapter.data.mod.getTime() && (
          <time datetime={chapter.data.mod.toISOString()}>
            actualizado {formatDate(chapter.data.mod)}
          </time>
        )}
        {chapter.data.tags.length > 0 && (
          <span class="flex flex-wrap gap-1">
            {chapter.data.tags.map((tag) => (
              <span class="rounded border border-dim px-1.5 py-0.5">
                {tag}
              </span>
            ))}
          </span>
        )}
      </div>
    </header>

    <Content />

    <footer class="mt-12 border-t border-dim pt-6 text-xs text-dim">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-accent hover:underline"
      >
        ← Volver al libro
      </a>
    </footer>
  </article>
</Layout>
