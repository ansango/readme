---
import { render } from "astro:content";
import Seo from "../../components/seo.astro";
import type { Chapter } from "../../content.config";
import Layout from "../../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../../lib/book-slug";
import { Books } from "../../lib/books";
import { Chapters } from "../../lib/chapters";
import { DateFormatter } from "../../lib/date-formatter";
import { formatReadingTime, readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const all = await Chapters.all();
  const grouped = Books.groupByBook(all);
  const result: Array<{
    params: { book: string; chapter: string };
    props: { chapter: Chapter; indexChapter: Chapter };
  }> = [];

  for (const [book, list] of grouped) {
    const indexChapter = Books.findIndex(book, list);
    if (!indexChapter) continue;
    for (const chapter of Chapters.getNumbered(list)) {
      result.push({
        params: {
          book,
          chapter: chapterIdFromId(chapter.id),
        },
        props: { chapter, indexChapter },
      });
    }
  }

  return result;
}

interface Props {
  chapter: Chapter;
  indexChapter: Chapter;
}

const { chapter, indexChapter } = Astro.props;
const { Content, headings } = await render(chapter);
// Filtramos a h2 y h3 (la h1 ya la elimina remarkStripFirstHeading).
// Astro genera los IDs de anchor con github-slugger, así que `slug`
// coincide 1:1 con el `id` que pone en el HTML.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const reading = readingTime(chapter.body ?? "");

const bookSlug = bookSlugFromId(chapter.id);
---

<Layout title={chapter.data.title} description={chapter.data.description}>
  <Fragment slot="seo">
    <Seo
      title={chapter.data.title}
      description={chapter.data.description}
      schemaType="Article"
      schemaData={{
        datePublished: chapter.data.date,
        dateModified: chapter.data.mod,
        author: { name: "ansango", url: "https://ansango.com" },
        inLanguage: "es",
        isPartOf: {
          name: indexChapter.data.title,
          url: new URL(`/${bookSlug}/`, Astro.site).toString(),
        },
        itemListElement: [
          {
            name: "README",
            url: new URL("/", Astro.site).toString(),
            position: 1,
          },
          {
            name: indexChapter.data.title,
            url: new URL(`/${bookSlug}/`, Astro.site).toString(),
            position: 2,
          },
          {
            name: chapter.data.title,
            url: new URL(Astro.url.pathname, Astro.site).toString(),
            position: 3,
          },
        ],
      }}
    />
  </Fragment>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-sm text-accent hover:underline"
        aria-label="Volver al inicio del libro"
      >
        ← Volver al libro
      </a>
      <h1
        id={chapterIdFromId(chapter.id)}
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {chapter.data.title}
      </h1>
      {chapter.data.description && (
				<p class="mt-2 text-sm text-dim md:text-base">
					{chapter.data.description}
				</p>
			)}
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-dim"
      >
        <time datetime={chapter.data.date.toISOString()}>
          {DateFormatter.spanishLong(chapter.data.date)}
        </time>
        {chapter.data.date.getTime() !== chapter.data.mod.getTime() && (
					<time datetime={chapter.data.mod.toISOString()}>
						actualizado {DateFormatter.spanishLong(chapter.data.mod)}
					</time>
				)}
        <span>{formatReadingTime(reading.minutes)} de lectura</span>
      </div>
    </header>

    {toc.length > 0 && (
				<aside aria-label="Tabla de contenidos">
					<h2>
						▾ En este capítulo<span class="count">({toc.length})</span>
					</h2>
					<ul>
						{toc.map((item) => (
							<li class={item.depth === 3 ? "depth-3" : ""}>
								<a href={`#${item.slug}`}>
									<span class="caret">
										{item.depth === 3 ? "·" : "▸"}
									</span>
									{item.text}
								</a>
							</li>
						))}
					</ul>
				</aside>
			)}

    <Content />

    <footer class="mt-12 border-t border-dim pt-6 text-xs text-dim not-prose">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-accent hover:underline"
      >
        ← Volver al libro
      </a>
    </footer>
  </article>
</Layout>
