---
import { render } from "astro:content";
import type { Chapter } from "../../content.config";
import Layout from "../../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../../lib/book-slug";
import { Chapters } from "../../lib/chapters";
import { DateFormatter } from "../../lib/date-formatter";
import { formatReadingTime, readingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const chapters = await Chapters.all();

  // El "00-..." actúa como índice del libro y vive en /{book}/, no
  // aquí. El resto de capítulos sí tienen su propia URL.
  return Chapters.getNumbered(chapters).map((c) => ({
    params: {
      book: bookSlugFromId(c.id),
      chapter: chapterIdFromId(c.id),
    },
    props: { chapter: c },
  }));
}

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);
// Filtramos a h2 y h3 (la h1 ya la elimina remarkStripFirstHeading).
// Astro genera los IDs de anchor con github-slugger, así que `slug`
// coincide 1:1 con el `id` que pone en el HTML.
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const reading = readingTime(chapter.body ?? "");
---

<Layout title={chapter.data.title} description={chapter.data.description}>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-sm text-accent hover:underline"
        aria-label="Volver al inicio del libro"
      >
        ← Volver al libro
      </a>
      <h1
        id={chapterIdFromId(chapter.id)}
        class="mt-4 font-mono font-medium text-foreground md:text-7xl"
      >
        {chapter.data.title}
      </h1>
      {chapter.data.description && (
				<p class="mt-2 text-sm text-dim md:text-base">
					{chapter.data.description}
				</p>
			)}
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-dim"
      >
        <time datetime={chapter.data.date.toISOString()}>
          {DateFormatter.spanishLong(chapter.data.date)}
        </time>
        {chapter.data.date.getTime() !== chapter.data.mod.getTime() && (
					<time datetime={chapter.data.mod.toISOString()}>
						actualizado {DateFormatter.spanishLong(chapter.data.mod)}
					</time>
				)}
        <span>{formatReadingTime(reading.minutes)} de lectura</span>
      </div>
    </header>

    {toc.length > 0 && (
				<aside aria-label="Tabla de contenidos">
					<h2>
						▾ En este capítulo<span class="count">({toc.length})</span>
					</h2>
					<ul>
						{toc.map((item) => (
							<li class={item.depth === 3 ? "depth-3" : ""}>
								<a href={`#${item.slug}`}>
									<span class="caret">
										{item.depth === 3 ? "·" : "▸"}
									</span>
									{item.text}
								</a>
							</li>
						))}
					</ul>
				</aside>
			)}

    <Content />

    <footer class="mt-12 border-t border-dim pt-6 text-xs text-dim not-prose">
      <a
        href={`/${bookSlugFromId(chapter.id)}/`}
        class="text-accent hover:underline"
      >
        ← Volver al libro
      </a>
    </footer>
  </article>
</Layout>
