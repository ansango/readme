---
import { getCollection } from "astro:content";
import DistroLogo from "../components/logos/distro-logo.astro";
import type { Chapter, ChapterData } from "../content.config";
import Layout from "../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../lib/book-slug";

const chapters = (await getCollection(
  "chapters",
  ({ data }: { data: ChapterData }) => !data.draft,
)) as Chapter[];

interface BookEntry {
  slug: string;
  index: Chapter | undefined;
  total: number;
}

// Agrupa capítulos por libro. El "00-..." es el índice del libro.
const books = new Map<string, BookEntry>();
for (const c of chapters) {
  const slug = bookSlugFromId(c.id);
  const id = chapterIdFromId(c.id);
  if (!slug || !id) continue;
  const entry = books.get(slug) ?? {
    slug,
    index: undefined,
    total: 0,
  };
  entry.total += 1;
  if (id.startsWith("00-") && !entry.index) entry.index = c;
  books.set(slug, entry);
}

const bookList = Array.from(books.entries())
  // exige un capítulo 00- para que el libro sea navegable
  .filter(([, v]) => v.index !== undefined)
  .map(([k, v]) => ({ slug: k, ...v }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<Layout
  title="Wiki"
  description="Biblioteca de wikis técnicas basadas en libros"
>
  <div class="mb-10 flex flex-col items-start gap-6 md:flex-row md:gap-12">
    <DistroLogo />
    <div>
      <h1
        class="mb-1.5 inline border-b border-dim pb-0.5 font-medium text-accent"
      >
        wiki<span class="text-dim">@</span>shelf
      </h1>
      <p class="text-dim">
        {bookList.length}
        {bookList.length === 1 ? " libro" : " libros"}
        · {chapters.length} capítulos
      </p>
    </div>
  </div>

  <ul class="border-y border-dim divide-y divide-dim">
    {bookList.map(({ slug, index, total }) => (
      <li class="py-4">
        <a href={`/${slug}/`} class="block hover:underline">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-medium text-accent">{index?.data.title}</span>
            <span class="text-xs text-dim">{total} caps.</span>
          </div>
          {index?.data.bookAuthor && (
            <div class="text-sm text-dim">por {index.data.bookAuthor}</div>
          )}
          {index?.data.description && (
            <p class="mt-1 text-sm">{index.data.description}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
</Layout>
