---
import { getCollection } from "astro:content";
import type { Chapter, ChapterData } from "../content.config";
import Layout from "../layouts/default.astro";
import { bookSlugFromId, chapterIdFromId } from "../lib/book-slug";

const chapters = (await getCollection(
  "chapters",
  ({ data }: { data: ChapterData }) => !data.draft,
)) as Chapter[];

interface BookEntry {
  slug: string;
  index: Chapter | undefined;
  total: number;
}

// Agrupa capítulos por libro. El "00-..." es el índice del libro y
// aporta los metadatos a nivel de libro (autor, subtítulo, tags).
const books = new Map<string, BookEntry>();
for (const c of chapters) {
  const slug = bookSlugFromId(c.id);
  const id = chapterIdFromId(c.id);
  if (!slug || !id) continue;
  const entry = books.get(slug) ?? {
    slug,
    index: undefined,
    total: 0,
  };
  entry.total += 1;
  if (id.startsWith("00-") && !entry.index) entry.index = c;
  books.set(slug, entry);
}

const bookList = Array.from(books.entries())
  // exige un capítulo 00- para que el libro sea navegable
  .filter(([, v]) => v.index !== undefined)
  .map(([k, v]) => ({ slug: k, ...v }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const totalTags = new Set(bookList.flatMap((b) => b.index?.data.tags ?? []))
  .size;

// Fecha en formato ISO corto (YYYY-MM-DD), alineado con el frontmatter.
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);

// Línea de caja estilo cabecera de README. Se trunca con overflow-hidden
// para que no rompa el layout en pantallas estrechas.
const HRULE = "─".repeat(60);
---

<Layout title="README" description="Wikis de libros que he leído">
  <header class="mb-10 font-mono">
    <div
      class="mb-3 select-none overflow-hidden whitespace-nowrap text-dim text-2xs"
    >
      {HRULE}
    </div>
    <h1 class="mb-2 font-medium text-accent text-2xl leading-none">README</h1>
    <p class="mb-3 italic text-dim">wikis de libros que he leído</p>
    <div
      class="mb-4 select-none overflow-hidden whitespace-nowrap text-dim text-2xs"
    >
      {HRULE}
    </div>
    <div class="flex flex-wrap gap-2 text-xs">
      <span class="border border-dim px-2 py-0.5 text-dim">
        {bookList.length}
        {bookList.length === 1 ? " libro" : " libros"}
      </span>
      <span class="border border-dim px-2 py-0.5 text-dim">
        {chapters.length}
        {chapters.length === 1 ? " capítulo" : " capítulos"}
      </span>
      {totalTags > 0 && (
        <span class="border border-dim px-2 py-0.5 text-dim">
          {totalTags}
          {totalTags === 1 ? " tag" : " tags"}
        </span>
      )}
    </div>
    <div
      class="mt-3 select-none overflow-hidden whitespace-nowrap text-dim text-2xs"
    >
      {HRULE}
    </div>
  </header>

  {bookList.length === 0 ? (
			<p class="text-dim">
				Aún no hay libros. Crea <code>src/content/&lt;book-slug&gt;/00-…md</code> para empezar.
			</p>
		) : (
			<ul class="grid gap-4 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
				{bookList.map(({ slug, index, total }) => {
					const data = index?.data;
					if (!data) return null;
					return (
						<li>
							<a
								href={`/${slug}/`}
								class="group flex h-full flex-col border border-border border-t-2 border-t-accent bg-transparent p-5 transition-colors hover:border-accent"
							>
								<div class="mb-3 flex items-start justify-between gap-3">
									<h2 class="font-medium text-accent leading-tight">
										{data.title}
									</h2>
									<span class="shrink-0 font-mono text-2xs text-dim">
										{total} {total === 1 ? "cap." : "caps."}
									</span>
								</div>

								{data.bookSubtitle && (
									<p class="mb-2 text-sm text-dim italic">
										{data.bookSubtitle}
									</p>
								)}

								{data.bookAuthor && (
									<p class="mb-3 text-xs text-dim">
										por <span class="text-fg">{data.bookAuthor}</span>
									</p>
								)}

								<p class="mb-4 line-clamp-3 text-sm leading-relaxed text-fg">
									{data.description}
								</p>

								{data.tags.length > 0 && (
									<div class="mb-4 flex flex-wrap gap-1.5">
										{data.tags.map((t) => (
											<span class="border border-dim px-1.5 py-0.5 font-mono text-2xs text-dim">
												{t}
											</span>
										))}
									</div>
								)}

								<div class="mt-auto flex items-center justify-between border-t border-dim pt-3 font-mono text-2xs text-dim">
									<span>{fmtDate(data.mod)}</span>
									<span class="opacity-0 transition-opacity group-hover:opacity-100">
										ver →
									</span>
								</div>
							</a>
						</li>
					);
				})}
			</ul>
		)}
</Layout>
