---
import Layout from "../layouts/default.astro";
import { Books } from "../lib/books";
import { Chapters } from "../lib/chapters";
import { DateFormatter } from "../lib/date-formatter";

const chapters = await Chapters.all();
const bookList = Books.listFromChapters(chapters);

const totalTags = new Set(bookList.flatMap((b) => b.index?.data.tags ?? []))
  .size;
---

<Layout title="README" description="Wikis de libros que he leído">
  <header class="mb-10 font-mono border border-dim">
    <!-- Barra de título tipo ventana: traffic lights + filename -->
    <div
      class="flex items-center gap-1.5 border-b border-dim px-3 py-1.5 text-dim text-2xs sm:gap-2 sm:px-4 sm:py-2"
    >
      <span class="text-accent">●</span>
      <span>○</span>
      <span>○</span>
      <span class="ml-2 truncate sm:ml-3">README.md</span>
    </div>

    <!-- Cuerpo: art a la izquierda, explicación a la derecha -->
    <div
      class="flex flex-col gap-5 p-5 sm:flex-row sm:items-start sm:gap-6 sm:p-6 md:gap-8 md:p-8"
    >
      <div
        class="min-w-0 flex-1 text-sm leading-relaxed sm:text-base space-y-4"
      >
        <p>
          Esta web es mi colección de apuntes sobre libros de tecnología. Cada
          libro vive como una wiki navegable: el capítulo <code>00-…</code> hace
          de índice y los siguientes son los capítulos numerados.
        </p>
        <p class="text-dim text-sm">
          El contenido es escrito por mi a partir de lo que voy aprendiendo, no
          reproduzco los libros. Si algo te interesa, lo mejor es
          <a href="/about" class="text-accent hover:underline"
            >consultar el aviso legal</a
          >
          y comprar el libro original.
        </p>
      </div>
    </div>
  </header>

  {bookList.length === 0 ? (
			<p class="text-dim">
				Aún no hay libros. Crea <code>src/content/&lt;book-slug&gt;/00-…md</code> para empezar.
			</p>
		) : (
			<ul class="grid gap-4 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
				{bookList.map(({ slug, index, total }) => {
					const data = index?.data;
					if (!data) return null;
					return (
						<li>
							<a
								href={`/${slug}/`}
								class="group flex h-full flex-col border border-border border-t-2 border-t-accent bg-transparent p-5 transition-colors hover:border-accent"
							>
								<div class="mb-3 flex items-start justify-between gap-3">
									<h2 class="font-medium text-accent leading-tight">
										{data.title}
									</h2>
									<span class="shrink-0 font-mono text-2xs text-dim">
										{total} {total === 1 ? "cap." : "caps."}
									</span>
								</div>

								<p class="mb-4 line-clamp-3 text-sm leading-relaxed text-fg">
									{data.description}
								</p>

								{data.tags.length > 0 && (
									<div class="mb-4 flex flex-wrap gap-1.5">
										{data.tags.map((t) => (
											<span class="border border-dim px-1.5 py-0.5 font-mono text-2xs text-dim">
												{t}
											</span>
										))}
									</div>
								)}

								<div class="mt-auto flex items-center justify-between border-t border-dim pt-3 font-mono text-2xs text-dim">
									<span>{DateFormatter.iso(data.mod)}</span>
									<span class="opacity-0 transition-opacity group-hover:opacity-100">
										ver →
									</span>
								</div>
							</a>
						</li>
					);
				})}
			</ul>
		)}
</Layout>
