---
import Seo from "../components/seo.astro";
import Layout from "../layouts/default.astro";
---

<Layout
  title="404 — Página no encontrada"
  description="La página que buscas no existe o ha sido movida."
>
  <Fragment slot="seo">
    <Seo
      title="404 — Página no encontrada"
      description="La página que buscas no existe o ha sido movida."
      schemaType="WebPage"
    />
  </Fragment>
  <article class="prose">
    <header class="mb-8 border-b border-dim pb-6 not-prose">
      <h1 class="mt-4 font-mono font-medium text-foreground md:text-7xl">
        404
      </h1>
      <p class="mt-2 text-sm text-dim md:text-base">
        La página que buscas no existe o ha sido movida.
      </p>
    </header>
    <p>
      <a href="/" class="text-accent hover:underline">← Volver al inicio</a>
    </p>
  </article>
</Layout>
