---
/**
 * Sheet footer — title block on the left, theme picker on the
 * right. Both are dashed-bordered chips, so the gap between
 * them keeps the row from reading as a fused band.
 *
 * Computes the `SHEET` value for the title block from the URL
 * depth (same logic the layouts used to do inline). Encapsulated:
 * the visual style lives here as Tailwind utilities, not in
 * `global.css`.
 */
import ThemePicker from "./theme-picker.astro";
import TitleBlock from "./title-block.astro";

const pathname = Astro.url.pathname;

/**
 * SHEET for the home page is always "01 / 03".
 *   /<book-slug>/         → "02 / 03"  (book index)
 *   /<book-slug>/<cap>/   → "03 / 03"  (chapter)
 *   anything deeper       → "03 / 03"  (fallback)
 */
const segments = pathname.split("/").filter(Boolean).length;
const sheet =
  segments <= 0 ? "01 / 03" : segments === 1 ? "02 / 03" : "03 / 03";
---

<footer
  class="relative z-[2] mt-10 flex flex-wrap items-center justify-between gap-6 border-t border-border pt-6 max-sm:flex-col max-sm:items-stretch max-sm:gap-4"
>
  <TitleBlock sheet={sheet} />
  <div class="flex flex-wrap items-center justify-end gap-2 text-[0.85rem]">
    <ThemePicker />
  </div>
</footer>
