---
/**
 * Theme picker for the footer — "blueprint" restyle.
 *
 * The trigger shows the active theme's accent color as a small
 * dot, the theme name in monospace, and a CSS-only chevron. The
 * menu opens above the trigger (the picker is in the footer)
 * and lists every theme with its own dot, so picking at sight
 * is fast.
 *
 *   [ ● catppuccin-latte ▾ ]
 *     ● catppuccin-latte
 *     ● peachy
 *     ● zebra
 *     …
 *
 * Tailwind utilities (bg-surface, text-text-1, border-border-strong,
 * text-accent-3) come from the @theme block in `global.css`, which
 * aliases the per-theme --color-* variables emitted by
 * `tools/generate-theme-css.mjs`.
 */
import { DEFAULT_THEME, STORAGE_KEY, themeAccent, themes } from "../lib/themes";
---

<div class="theme-picker relative inline-block font-mono">
  <button
    type="button"
    id="theme-trigger"
    class="theme-trigger inline-flex cursor-pointer items-center gap-2 rounded-sm border border-border-strong bg-surface py-1.5 pl-2.5 pr-7 text-[11px] font-medium tracking-wider text-text-1 uppercase outline-none transition-colors hover:border-accent-2 hover:text-accent-3 aria-expanded:border-accent-3 aria-expanded:text-accent-3"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span
      class="theme-swatch inline-block h-2 w-2 shrink-0 rounded-full ring-1 ring-inset ring-black/15"
      data-current-swatch
      style={`background:${themeAccent[DEFAULT_THEME]}`}
      aria-hidden="true"
    ></span>
    <span data-current-theme>{DEFAULT_THEME}</span>
    <span
      class="theme-chevron pointer-events-none absolute top-1/2 right-2 -translate-y-1/2"
      aria-hidden="true"
    ></span>
  </button>
  <div
    id="theme-menu"
    class="theme-menu absolute right-0 bottom-full z-50 mb-1 max-h-64 w-56 overflow-y-auto rounded-sm border border-border-strong bg-bg-soft text-[0.7rem] shadow-lg"
    role="listbox"
    aria-label="temas"
    hidden
  >
    {themes.map((t) => (
      <button
        type="button"
        class="theme-menu-item flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left text-text-3 tracking-wider uppercase hover:bg-surface-2 hover:text-text-1 aria-selected:text-accent-3"
        data-theme-option={t}
        role="option"
        aria-selected="false"
      >
        <span
          class="theme-swatch inline-block h-2 w-2 shrink-0 rounded-full ring-1 ring-inset ring-black/15"
          style={`background:${themeAccent[t]}`}
          aria-hidden="true"
        ></span>
        <span class="truncate">{t}</span>
      </button>
    ))}
  </div>
</div>

<style>
  /* Chevron — CSS triangle in --accent-3, mirrors the
     design's <select> arrow. Positioned absolutely inside
     the trigger so it doesn't shift the layout when the
     theme name changes width. */
  .theme-chevron {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--accent-3);
  }
</style>

<script>
  /**
   * Theme picker client. Single dropdown, vanilla TS, no framework.
   * Mirrors the layout's anti-FOUC logic so the SSR markup and
   * the live state always agree.
   */
  import { DEFAULT_THEME, STORAGE_KEY, themeAccent } from "../lib/themes";

  const root = document.documentElement;
  const trigger = document.getElementById(
    "theme-trigger",
  ) as HTMLButtonElement | null;
  const menu = document.getElementById("theme-menu") as HTMLDivElement | null;
  const label = document.querySelector<HTMLElement>("[data-current-theme]");
  const swatch = document.querySelector<HTMLElement>("[data-current-swatch]");
  const options = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-option]",
  );

  function apply(theme: string) {
    root.dataset.theme = theme;
    localStorage.setItem(STORAGE_KEY, theme);
    if (label) label.textContent = theme;
    if (swatch) {
      const color = themeAccent[theme as keyof typeof themeAccent];
      if (color) swatch.style.background = color;
    }
    for (const option of options) {
      option.setAttribute(
        "aria-selected",
        option.dataset.themeOption === theme ? "true" : "false",
      );
    }
  }

  function open() {
    if (!menu || !trigger) return;
    menu.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
  }
  function close() {
    if (!menu || !trigger) return;
    menu.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
  }
  function toggle() {
    if (!menu) return;
    if (menu.hidden) open();
    else close();
  }

  trigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggle();
  });
  menu?.addEventListener("click", (e) => e.stopPropagation());
  for (const option of options) {
    const theme = option.dataset.themeOption;
    if (theme) {
      option.addEventListener("click", (e) => {
        e.stopPropagation();
        apply(theme);
        close();
      });
    }
  }
  document.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });

  // Initial sync — read what's already in storage (or in the
  // SSR-applied data-theme) and reflect it on the trigger.
  const stored = localStorage.getItem(STORAGE_KEY);
  const initial = stored ?? root.dataset.theme ?? DEFAULT_THEME;
  apply(initial);
</script>
