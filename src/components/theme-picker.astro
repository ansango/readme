---
/**
 * Two-pane theme picker for the footer.
 *
 * Replaces the old single `DistroToggle` dropdown with two clearly
 * separated groups: distros (26) and Glance palettes (14). Each
 * group has its own trigger + dropdown, its own "last picked"
 * localStorage key, and its own default. The active theme (= the
 * value of `data-theme` on `<html>`) is whatever the user picked
 * most recently; the *other* picker's label still shows the last
 * theme of its own kind, so switching back is one click.
 *
 *   distro: [ debian         ▾ ] · glance: [ catppuccin-mocha  ▾ ]
 *                  ▲ active (border in accent)         ▲ last picked
 *
 * Active state is shown with an accent border on the trigger that
 * matches the currently applied theme.
 */
import {
  DEFAULT_GLANCER,
  DEFAULT_THEME,
  distros,
  glance,
  STORAGE_KEY,
  STORAGE_KEY_DISTRO,
  STORAGE_KEY_GLANCER,
} from "../lib/themes";

// Both lists come from `themes.ts` and are already alphabetical.
---

<div
  class="theme-picker inline-flex flex-wrap items-center justify-end gap-x-2 gap-y-1 font-mono text-2xs"
>
  <!-- ───── Distro group ───── -->
  <div class="theme-group relative inline-flex items-center gap-1">
    <span class="text-border">distro:</span>
    <button
      type="button"
      class="theme-trigger cursor-pointer border border-border bg-panel px-2 py-1 text-fg hover:border-accent hover:text-accent aria-expanded:border-accent aria-expanded:text-accent"
      data-kind="distro"
      data-current-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
    >
      <span data-current-theme="distro">{DEFAULT_THEME}</span>
      <span class="text-border" aria-hidden="true">▾</span>
    </button>
    <div
      class="theme-menu absolute right-0 bottom-full z-50 mb-1 max-h-64 w-44 overflow-y-auto border border-border bg-panel text-[0.75rem] shadow-lg"
      data-menu="distro"
      role="listbox"
      aria-label="distro themes"
      hidden
    >
      {distros.map((t) => (
        <button
          type="button"
          class="block w-full cursor-pointer px-3 py-1 text-left text-dim hover:bg-fg/10 hover:text-accent aria-selected:text-accent"
          data-theme-option={t}
          data-kind="distro"
          role="option"
          aria-selected="false"
        >
          {t}
        </button>
      ))}
    </div>
  </div>

  <span class="text-border" aria-hidden="true">·</span>

  <!-- ───── Glance group ───── -->
  <div class="theme-group relative inline-flex items-center gap-1">
    <span class="text-border">glance:</span>
    <button
      type="button"
      class="theme-trigger cursor-pointer border border-border bg-panel px-2 py-1 text-fg hover:border-accent hover:text-accent aria-expanded:border-accent aria-expanded:text-accent"
      data-kind="glance"
      data-current-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
    >
      <span data-current-theme="glance">{DEFAULT_GLANCER}</span>
      <span class="text-border" aria-hidden="true">▾</span>
    </button>
    <div
      class="theme-menu absolute right-0 bottom-full z-50 mb-1 max-h-64 w-44 overflow-y-auto border border-border bg-panel text-[0.75rem] shadow-lg"
      data-menu="glance"
      role="listbox"
      aria-label="glance themes"
      hidden
    >
      {glance.map((t) => (
        <button
          type="button"
          class="block w-full cursor-pointer px-3 py-1 text-left text-dim hover:bg-fg/10 hover:text-accent aria-selected:text-accent"
          data-theme-option={t}
          data-kind="glance"
          role="option"
          aria-selected="false"
        >
          {t}
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  /**
   * Theme picker client. Two independent dropdowns, one per kind.
   * Each remembers the user's last pick in its own localStorage
   * key (`STORAGE_KEY_DISTRO` / `STORAGE_KEY_GLANCER`) so the
   * non-active picker still shows the right "last picked" value
   * after the user switches between kinds. The currently applied
   * theme continues to live in `STORAGE_KEY`.
   */
  import {
    DEFAULT_GLANCER,
    DEFAULT_THEME,
    kindOf,
    STORAGE_KEY,
    STORAGE_KEY_DISTRO,
    STORAGE_KEY_GLANCER,
  } from "../lib/themes";

  const isTheme = (v: string | null): v is string =>
    !!v && v === "string" && /^[a-z0-9-]+$/.test(v);

  const root = document.documentElement;
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    ".theme-picker [data-current-trigger]",
  );
  const allOptions = document.querySelectorAll<HTMLButtonElement>(
    ".theme-picker [data-theme-option]",
  );

  /** Read a per-kind "last picked" value, falling back to the
   * active theme (if it matches the kind) or to the per-kind default. */
  function lastPicked(kind: "distro" | "glance"): string {
    const key = kind === "distro" ? STORAGE_KEY_DISTRO : STORAGE_KEY_GLANCER;
    const fallback = kind === "distro" ? DEFAULT_THEME : DEFAULT_GLANCER;
    const stored = localStorage.getItem(key);
    if (stored) return stored;
    const active =
      localStorage.getItem(STORAGE_KEY) ?? root.dataset.theme ?? "";
    if (active && kindOf(active as never) === kind) return active;
    return fallback;
  }

  function apply(theme: string) {
    if (kindOf(theme as never) === "distro") {
      localStorage.setItem(STORAGE_KEY_DISTRO, theme);
    } else {
      localStorage.setItem(STORAGE_KEY_GLANCER, theme);
    }
    localStorage.setItem(STORAGE_KEY, theme);
    root.dataset.theme = theme;
    syncUi();
  }

  function syncUi() {
    const active =
      localStorage.getItem(STORAGE_KEY) ?? root.dataset.theme ?? DEFAULT_THEME;
    const activeKind = kindOf(active as never);

    // Update each trigger's label + active state.
    for (const t of triggers) {
      const kind = (t.dataset.kind as "distro" | "glance") ?? "distro";
      const labelEl = t.querySelector<HTMLElement>(
        `[data-current-theme="${kind}"]`,
      );
      if (labelEl) labelEl.textContent = lastPicked(kind);
      t.classList.toggle("is-active", kind === activeKind);
      t.setAttribute("aria-expanded", "false");
    }

    // Mark the matching option in each menu as `aria-selected`.
    for (const opt of allOptions) {
      const isActive = opt.dataset.themeOption === active;
      opt.setAttribute("aria-selected", isActive ? "true" : "false");
    }
  }

  function closeAll() {
    for (const t of triggers) t.setAttribute("aria-expanded", "false");
    document
      .querySelectorAll<HTMLElement>(".theme-picker .theme-menu")
      .forEach((m) => {
        m.hidden = true;
      });
  }

  function openMenu(kind: "distro" | "glance") {
    closeAll();
    const trigger = document.querySelector<HTMLButtonElement>(
      `.theme-picker [data-current-trigger][data-kind="${kind}"]`,
    );
    const menu = document.querySelector<HTMLElement>(
      `.theme-picker [data-menu="${kind}"]`,
    );
    if (trigger) trigger.setAttribute("aria-expanded", "true");
    if (menu) menu.hidden = false;
  }

  for (const trigger of triggers) {
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const kind = (trigger.dataset.kind as "distro" | "glance") ?? "distro";
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) closeAll();
      else openMenu(kind);
    });
  }

  for (const menu of document.querySelectorAll<HTMLElement>(
    ".theme-picker .theme-menu",
  )) {
    menu.addEventListener("click", (e) => e.stopPropagation());
  }

  for (const opt of allOptions) {
    opt.addEventListener("click", (e) => {
      e.stopPropagation();
      const theme = opt.dataset.themeOption;
      if (!theme) return;
      apply(theme);
      closeAll();
    });
  }

  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  // Initial render — set the active theme to whatever is in storage
  // (or the default), so per-kind "last picked" labels are correct.
  const initialActive =
    localStorage.getItem(STORAGE_KEY) ?? root.dataset.theme ?? DEFAULT_THEME;
  if (root.dataset.theme !== initialActive) {
    root.dataset.theme = initialActive;
  }
  // Seed the per-kind keys if they're missing, so the next reload
  // is consistent with the current theme.
  if (
    !localStorage.getItem(STORAGE_KEY_DISTRO) &&
    kindOf(initialActive as never) === "distro"
  ) {
    localStorage.setItem(STORAGE_KEY_DISTRO, initialActive);
  }
  if (
    !localStorage.getItem(STORAGE_KEY_GLANCER) &&
    kindOf(initialActive as never) === "glance"
  ) {
    localStorage.setItem(STORAGE_KEY_GLANCER, initialActive);
  }
  syncUi();
</script>
