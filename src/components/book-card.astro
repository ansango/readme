---
/**
 * One book card — "blueprint" restyle.
 *
 * Visual changes vs the previous card:
 *   - dashed border (was solid) — picks up the sheet chrome
 *   - background fills with --surface (was transparent)
 *   - no top accent stripe (the dashed border + accent-3 on
 *     the title is the only "accent" treatment)
 *   - tighter typography scale (text-1 / text-2 / text-3
 *     from the new design tokens)
 *   - title and caps live in a head row separated by a
 *     dashed border, mirroring the design's book card
 *
 * Functional behavior preserved from the previous version:
 *   - Stretched-link pattern: the outer element is an
 *     `<article>` (NOT an `<a>`, because having `<button>`s
 *     inside an `<a>` is invalid HTML). The title is a real
 *     `<a>` whose `::after` pseudo-element covers the whole
 *     card, so any click outside a tag button navigates.
 *   - Tag buttons sit above the stretched link with a higher
 *     z-index.
 *   - `MAX_TAGS = 3` overflow rule + `+N` indicator with
 *     `title=` for the hidden tags.
 *   - `ver →` arrow appears on hover, just like before.
 *
 * `book.total` is the count of chapters INCLUDING the `00-`
 * index of each book. The visible chapter count for the UI
 * is `total - 1` (the 00- is the book home, not a numbered
 * chapter).
 */

import type { Book } from "../lib/books";
import { DateFormatter } from "../lib/date-formatter";

interface Props {
  book: Book;
}

const { book } = Astro.props;
const data = book.index.data;
const MAX_TAGS = 3;
const visibleTags = data.tags.slice(0, MAX_TAGS);
const hiddenCount = data.tags.length - visibleTags.length;
const visibleChapters = Math.max(0, book.total - 1);
const chaptersText = `${visibleChapters} ${visibleChapters === 1 ? "cap." : "caps."}`;
---

<li class="flex h-full">
  <article
    class="bookshelf-card group relative flex h-full w-full flex-col rounded-sm border border-dashed border-border-strong bg-surface p-5 transition-colors hover:border-accent-2 hover:bg-surface-2"
  >
    <header
      class="mb-4 flex items-baseline justify-between gap-3 border-b border-dashed border-border-strong pb-3"
    >
      <h2
        class="min-h-[2lh] text-base font-bold leading-tight tracking-tight text-text-1 line-clamp-2"
      >
        <a
          href={`/${book.slug}/`}
          class="card-stretched-link no-underline text-text-1 visited:text-text-1 hover:text-accent-3"
        >
          {data.title}
        </a>
      </h2>
      <span
        class="shrink-0 font-mono text-[10px] font-medium tracking-wider text-text-3 uppercase"
      >
        {chaptersText}
      </span>
    </header>

    <p
      class="bookshelf-card-desc mb-4 line-clamp-3 text-[12.5px] leading-relaxed font-light text-text-2"
    >
      {data.description}
    </p>

    {data.tags.length > 0 && (
      <div class="bookshelf-card-tags mb-4 flex flex-wrap items-center gap-1.5">
        {visibleTags.map((t) => (
          <button
            type="button"
            class="bookshelf-tag-btn relative z-10 rounded-sm border border-dashed border-border-strong px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-text-2 uppercase hover:border-accent-2 hover:text-accent-3"
            data-tag={t}
          >
            #{t}
          </button>
        ))}
        {hiddenCount > 0 && (
          <span
            class="rounded-sm border border-dashed border-border-strong px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-accent-3 uppercase"
            title={data.tags.slice(MAX_TAGS).map((t) => `#${t}`).join(" ")}
          >
            +{hiddenCount}
          </span>
        )}
      </div>
    )}

    <div
      class="mt-auto flex items-center justify-between border-t border-dashed border-border-strong pt-3 font-mono text-[10px] tracking-widest text-text-3 uppercase"
    >
      <span>{DateFormatter.iso(data.mod)}</span>
      <span
        class="opacity-0 transition-opacity group-hover:opacity-100"
        aria-hidden="true"
      >
        ver →
      </span>
    </div>
  </article>
</li>
