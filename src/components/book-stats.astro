---
/**
 * Stats bar for the bookshelf: X libros · Y caps. · Z tags · última
 * nota <date>. Server renders the structure; the script in
 * `book-list.astro` fills the numbers in once the book list is in
 * hand so they stay consistent with the filter UI.
 */
---

<dl
  class="bookshelf-stats flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-dashed border-border-dim pt-3 font-mono text-2xs text-dim"
  aria-live="polite"
>
  <div class="flex items-baseline gap-1">
    <dt class="sr-only">libros</dt>
    <dd>
      <strong id="bookshelf-stat-books" class="font-medium text-fg tabular-nums"
        >—</strong
      >
      libros
    </dd>
  </div>
  <span class="text-border" aria-hidden="true">·</span>
  <div class="flex items-baseline gap-1">
    <dt class="sr-only">capítulos</dt>
    <dd>
      <strong
        id="bookshelf-stat-chapters"
        class="font-medium text-fg tabular-nums"
        >—</strong
      >
      caps.
    </dd>
  </div>
  <span class="text-border" aria-hidden="true">·</span>
  <div class="flex items-baseline gap-1">
    <dt class="sr-only">tags</dt>
    <dd>
      <strong id="bookshelf-stat-tags" class="font-medium text-fg tabular-nums"
        >—</strong
      >
      tags
    </dd>
  </div>
  <span class="text-border" aria-hidden="true">·</span>
  <div class="flex items-baseline gap-1">
    <dt class="sr-only">última nota</dt>
    <dd>
      última nota <time id="bookshelf-stat-lastmod" class="text-fg">—</time>
    </dd>
  </div>
</dl>
