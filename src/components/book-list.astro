---
/**
 * Bookshelf — the new home page layout. Keeps the existing visual
 * language of the site (mono, border-dim, terminal look) and adds
 * a search input, a tag-filter chip bar, a stats line and a sort
 * segmented control above the grid of `book-card`s.
 *
 * Server-side:
 *   - Receives the `bookList` aggregate from `index.astro` (same
 *     shape as before — produced by `Books.listFromChapters`).
 *   - Renders the layout shell + a `book-card` per book, exactly
 *     as the previous implementation did. The visual card itself
 *     lives in `book-card.astro` to keep this file small.
 *   - Serialises a *minimum* projection of each book into a
 *     `<script type="application/json">` island for the client
 *     script to read — no extra fetches.
 *
 * Client-side (`<script>` at the bottom):
 *   - Live search: matches title / description / tags.
 *   - Tag filter: AND semantics (book must have ALL active tags).
 *   - Sort: `recent` (mod desc) / `a-z` (title asc) / `caps.`
 *     (visible chapter count desc).
 *   - Keyboard: `/` focuses the search input; `Esc` clears it.
 *
 * Conventions respected:
 *   - Spanish copy ("cap." / "caps.", "mostrando X de Y libros")
 *   - `font-mono` for meta and tag chips
 *   - `border-border` / `border-dim` / `text-fg/dim/accent`
 *   - `/{slug}/` for book links
 */

import type { Book } from "../lib/books";
import BookCard from "./book-card.astro";
import BookSearch from "./book-search.astro";
import BookStats from "./book-stats.astro";
import BookTagBar from "./book-tag-bar.astro";
import LibraryControls from "./library-controls.astro";

interface Props {
  bookList: Book[];
}

const { bookList } = Astro.props;

const projection = bookList.map((b) => ({
  slug: b.slug,
  title: b.index.data.title,
  description: b.index.data.description,
  tags: b.index.data.tags,
  mod: b.index.data.mod.toISOString(),
  caps: Math.max(0, b.total - 1),
}));
---

<section class="bookshelf space-y-4" data-bookshelf>
  <BookSearch />
  <BookTagBar />
  <BookStats />
  <LibraryControls />

  {bookList.length === 0 ? (
    <p class="font-mono text-sm text-dim">
      Todavía no hay libros. Crea <code>src/content/&lt;book-slug&gt;/00-…md</code> para empezar.
    </p>
  ) : (
    <ul
      id="bookshelf-grid"
      class="grid items-stretch gap-4 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4"
    >
      {bookList.map((book) => (
        <BookCard book={book} />
      ))}
    </ul>
  )}

  <p
    id="bookshelf-empty"
    class="hidden border border-border p-6 text-center font-mono text-sm text-dim"
  >
    <span class="text-accent">∅</span>
    ningún libro coincide con tu búsqueda.
    <button
      type="button"
      id="bookshelf-reset"
      class="ml-2 text-accent underline underline-offset-2 hover:text-fg"
    >
      quitar filtros
    </button>
  </p>

  <script
    type="application/json"
    id="bookshelf-data"
    set:html={JSON.stringify(projection)}
  ></script>
</section>

<script>
  /**
   * Bookshelf client. Pure vanilla TS, no framework. Reads the JSON
   * island and wires up live search, tag filter, sort and keyboard
   * shortcuts. All DOM ids are declared in the matching components:
   * book-search, book-tag-bar, book-stats, library-controls,
   * book-card. If you rename any, update them here too.
   */
  type BookRow = {
    slug: string;
    title: string;
    description: string;
    tags: string[];
    mod: string;
    caps: number;
  };

  const root = document.querySelector<HTMLElement>("[data-bookshelf]");
  if (root) {
    const dataEl = document.getElementById("bookshelf-data");
    const grid = document.getElementById(
      "bookshelf-grid",
    ) as HTMLElement | null;
    const sub = document.getElementById("bookshelf-sub");
    const empty = document.getElementById("bookshelf-empty");
    const tagBar = document.getElementById("bookshelf-tag-bar");
    const searchInput = document.getElementById(
      "bookshelf-search-input",
    ) as HTMLInputElement | null;
    const sortButtons = root.querySelectorAll<HTMLButtonElement>(
      ".bookshelf-sort-btn",
    );
    const statBooks = document.getElementById("bookshelf-stat-books");
    const statChapters = document.getElementById("bookshelf-stat-chapters");
    const statTags = document.getElementById("bookshelf-stat-tags");
    const statLastmod = document.getElementById("bookshelf-stat-lastmod");

    const books: BookRow[] = dataEl
      ? JSON.parse(dataEl.textContent ?? "[]")
      : [];
    const allTags = new Set<string>();
    for (const b of books) for (const t of b.tags) allTags.add(t);

    const state = {
      query: "",
      activeTags: new Set<string>(),
      sort: "recent" as "recent" | "title" | "chapters",
    };

    function escapeHtml(s: string): string {
      return s.replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c] as string,
      );
    }

    function matchesQuery(b: BookRow): boolean {
      if (!state.query) return true;
      const q = state.query.toLowerCase();
      return (
        b.title.toLowerCase().includes(q) ||
        b.description.toLowerCase().includes(q) ||
        b.tags.some((t) => t.toLowerCase().includes(q))
      );
    }

    function matchesTags(b: BookRow): boolean {
      if (state.activeTags.size === 0) return true;
      for (const t of state.activeTags) if (!b.tags.includes(t)) return false;
      return true;
    }

    function sortBooks(list: BookRow[]): BookRow[] {
      const out = [...list];
      if (state.sort === "recent")
        out.sort((a, b) => b.mod.localeCompare(a.mod));
      else if (state.sort === "title")
        out.sort((a, b) => a.title.localeCompare(b.title));
      else if (state.sort === "chapters") out.sort((a, b) => b.caps - a.caps);
      return out;
    }

    /**
     * Tag bar reflects the *search-respecting* corpus (so counts are
     * meaningful for whatever the user is typing) but never filters
     * by the active tag set (otherwise every count would collapse
     * to the intersection size, which is rarely useful).
     */
    function rebuildTagBar(filtered: BookRow[]) {
      if (!tagBar) return;
      const counts = new Map<string, number>();
      for (const b of filtered)
        for (const t of b.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
      const total = filtered.length;
      const sorted = [...counts.entries()].sort(
        (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
      );
      const chips: string[] = [];
      const allActive = state.activeTags.size === 0;
      /**
       * Chip style mirrors the in-card tag chips in `book-card.astro`:
       * dashed border, text-text-2 by default, accent-3 border on the
       * active filter. The static `border-border-strong` is the same
       * weight as the card so they read as a single visual family.
       */
      const baseChip =
        "relative z-10 rounded-sm border border-dashed border-border-strong px-1.5 py-0.5 font-mono text-2xs tracking-wider uppercase";
      const activeChip = "border-accent-3 text-accent-3";
      const inactiveChip =
        "text-text-2 hover:border-accent-2 hover:text-accent-3";
      chips.push(
        `<button type="button" class="bookshelf-tag-btn ${baseChip} ${allActive ? activeChip : inactiveChip}" data-tag="__all__">todos <span class="opacity-60">${total}</span></button>`,
      );
      for (const [tag, count] of sorted) {
        const isActive = state.activeTags.has(tag);
        chips.push(
          `<button type="button" class="bookshelf-tag-btn ${baseChip} ${isActive ? activeChip : inactiveChip}" data-tag="${escapeHtml(tag)}">#${escapeHtml(tag)} <span class="opacity-60">${count}</span></button>`,
        );
      }
      tagBar.innerHTML = chips.join("");
    }

    function render() {
      const filtered = books.filter((b) => matchesQuery(b) && matchesTags(b));
      const sorted = sortBooks(filtered);

      if (grid) {
        // Update the *style* of each card (hide/show) instead of
        // re-rendering the whole grid. Cheaper and preserves any
        // browser state (focus, scroll position) on each card.
        const cardsBySlug = new Map<string, HTMLElement>();
        for (const li of Array.from(grid.querySelectorAll<HTMLElement>("li"))) {
          const a = li.querySelector<HTMLAnchorElement>("a.bookshelf-card");
          if (!a) continue;
          const m = a.getAttribute("href")?.match(/^\/([^/]+)\/$/);
          if (m) cardsBySlug.set(decodeURIComponent(m[1]), li);
        }
        const visibleSlugs = new Set(sorted.map((b) => b.slug));
        for (const [slug, li] of cardsBySlug) {
          li.classList.toggle("hidden", !visibleSlugs.has(slug));
        }
        // For slugs that match but aren't server-rendered (none
        // in this layout, but defensive): skip. The data is the
        // same set.
      }

      if (sub)
        sub.textContent = `mostrando ${sorted.length} de ${books.length} libros`;
      if (empty) empty.classList.toggle("hidden", sorted.length > 0);
      if (grid) grid.classList.toggle("hidden", sorted.length === 0);

      // Tag bar: counts over the search-only filtered corpus.
      const queryOnly = books.filter(matchesQuery);
      rebuildTagBar(queryOnly);

      // Reflect the active state on the *server-rendered* tag
      // buttons inside the cards. The bar's chips are rebuilt
      // from scratch; the in-card ones live in the SSR markup.
      // Matches the chip style emitted by `rebuildTagBar` above.
      for (const btn of root.querySelectorAll<HTMLButtonElement>(
        ".bookshelf-tag-btn",
      )) {
        const t = btn.dataset.tag ?? "";
        const isActive =
          t === "__all__"
            ? state.activeTags.size === 0
            : state.activeTags.has(t);
        btn.classList.toggle("border-accent-3", isActive);
        btn.classList.toggle("text-accent-3", isActive);
        btn.classList.toggle("border-border-strong", !isActive);
        btn.classList.toggle("text-text-2", !isActive);
      }
    }

    // --- stats (computed once) ------------------------------------
    if (statBooks) statBooks.textContent = String(books.length);
    if (statChapters) {
      const totalCaps = books.reduce((acc, b) => acc + b.caps, 0);
      statChapters.textContent = String(totalCaps);
    }
    if (statTags) statTags.textContent = String(allTags.size);
    if (statLastmod && books.length > 0) {
      const latest = books.reduce(
        (acc, b) => (b.mod > acc ? b.mod : acc),
        books[0].mod,
      );
      const d = new Date(latest);
      statLastmod.textContent = d.toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
      statLastmod.setAttribute("datetime", latest);
    }

    // --- events ---------------------------------------------------
    searchInput?.addEventListener("input", () => {
      state.query = (searchInput.value ?? "").trim();
      render();
    });
    searchInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        searchInput.value = "";
        state.query = "";
        render();
        searchInput.blur();
      }
    });
    searchInput
      ?.closest("search")
      ?.addEventListener("submit", (e) => e.preventDefault());

    document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      const inField =
        t &&
        (t.tagName === "INPUT" ||
          t.tagName === "TEXTAREA" ||
          t.isContentEditable);
      if (inField) return;
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    });

    // Event delegation: sort buttons, tag chips, reset button.
    root.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const sortBtn = target.closest<HTMLButtonElement>(".bookshelf-sort-btn");
      if (sortBtn) {
        const next = sortBtn.dataset.sort as typeof state.sort | undefined;
        if (next) {
          state.sort = next;
          for (const b of sortButtons) {
            const active = b === sortBtn;
            b.classList.toggle("is-active", active);
            b.classList.toggle("text-fg", active);
            b.classList.toggle("text-dim", !active);
            b.setAttribute("aria-selected", active ? "true" : "false");
          }
          render();
        }
        return;
      }

      const tagBtn = target.closest<HTMLButtonElement>(".bookshelf-tag-btn");
      if (tagBtn) {
        // Anchor-wrapped cards: stop the click from bubbling to
        // the parent <a> (otherwise clicking a tag in a card would
        // navigate to the book). The stretched-link handles
        // navigation for non-tag clicks.
        e.preventDefault();
        e.stopPropagation();
        const t = tagBtn.dataset.tag ?? "";
        if (t === "__all__") {
          state.activeTags.clear();
        } else {
          if (state.activeTags.has(t)) state.activeTags.delete(t);
          else state.activeTags.add(t);
        }
        render();
        return;
      }

      if (target.closest("#bookshelf-reset")) {
        state.activeTags.clear();
        state.query = "";
        if (searchInput) searchInput.value = "";
        render();
      }
    });

    // Initial paint.
    render();
  }
</script>
