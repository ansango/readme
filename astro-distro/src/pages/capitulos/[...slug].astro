---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/default.astro";

export async function getStaticPaths() {
	const chapters = await getCollection("chapters", ({ data }) => !data.draft);
	return chapters.map((chapter) => ({
		params: { slug: chapter.slug },
		props: { chapter },
	}));
}

interface Props {
	chapter: CollectionEntry<"chapters">;
}

const { chapter } = Astro.props;
const { Content } = await chapter.render();

const formatDate = (d: Date) =>
	d.toLocaleDateString("es-ES", {
		day: "2-digit",
		month: "short",
		year: "numeric",
	});
---

<Layout title={chapter.data.title} description={chapter.data.description}>
	<article class="mx-auto max-w-3xl px-4 py-10">
		<header class="mb-8 border-b border-dim pb-6">
			<a
				href="/"
				class="text-accent text-sm hover:underline"
				aria-label="Volver al índice"
			>
				← Linux Basics for Hackers
			</a>
			<h1 class="mt-4 font-mono text-2xl font-medium text-foreground md:text-3xl">
				{chapter.data.title}
			</h1>
			{
				chapter.data.description && (
					<p class="mt-2 text-dim text-sm md:text-base">
						{chapter.data.description}
					</p>
				)
			}
			<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-dim text-xs">
				<time datetime={chapter.data.date.toISOString()}>
					{formatDate(chapter.data.date)}
				</time>
				{
					chapter.data.date.getTime() !== chapter.data.mod.getTime() && (
						<time datetime={chapter.data.mod.toISOString()}>
							actualizado {formatDate(chapter.data.mod)}
						</time>
					)
				}
				{
					chapter.data.tags.length > 0 && (
						<span class="flex flex-wrap gap-1">
							{chapter.data.tags.map((tag) => (
								<span class="rounded border border-dim px-1.5 py-0.5">
									{tag}
								</span>
							))}
						</span>
					)
				}
			</div>
		</header>

		<div
			class="prose prose-headings:font-mono prose-headings:text-foreground prose-a:text-accent prose-code:font-mono max-w-none"
		>
			<Content />
		</div>

		<footer class="mt-12 border-t border-dim pt-6 text-dim text-xs">
			<a href="/" class="text-accent hover:underline">
				← Volver al índice de capítulos
			</a>
		</footer>
	</article>
</Layout>