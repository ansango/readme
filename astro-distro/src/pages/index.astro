---
import { getCollection } from "astro:content";
import Layout from "../layouts/default.astro";

const chapters = (await getCollection("chapters", ({ data }) => !data.draft)).sort(
	(a, b) => a.slug.localeCompare(b.slug),
);

const formatDate = (d: Date) =>
	d.toLocaleDateString("es-ES", {
		day: "2-digit",
		month: "short",
		year: "numeric",
	});

const total = chapters.length;
const totalTags = new Set(chapters.flatMap((c) => c.data.tags)).size;
const latest = chapters.reduce((acc, c) =>
	c.data.mod > acc.data.mod ? c : acc,
);
---

<Layout
	title="Linux Basics for Hackers · Wiki"
	description={`Wiki de ${total} capítulos sobre Linux, sysadmin y hacking.`}
>
	<div class="mx-auto max-w-3xl px-4 py-10">
		<header class="mb-10 border-b border-dim pb-6">
			<h1 class="font-mono text-2xl font-medium md:text-3xl">
				Linux Basics for Hackers
			</h1>
			<p class="mt-2 text-dim text-sm md:text-base">
				Wiki de <span class="text-accent">{total}</span> capítulos sobre fundamentos de
				Linux, redes, scripting, seguridad y Python aplicado. Basada en el libro
				<em> Linux Basics for Hackers</em> de OccupyTheWeb.
			</p>
			<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-dim text-xs">
				<span>{total} capítulos</span>
				<span>{totalTags} tags</span>
				<span>
					Última actualización: <time
						datetime={latest.data.mod.toISOString()}
						class="text-accent">{formatDate(latest.data.mod)}</time>
				</span>
			</div>
		</header>

		<ol class="space-y-3">
			{
				chapters.map((chapter, idx) => (
					<li
						class="group rounded border border-transparent px-3 py-2 transition hover:border-dim hover:bg-foreground/5"
					>
						<a
							href={`/capitulos/${chapter.slug}/`}
							class="flex items-baseline gap-3"
						>
							<span class="font-mono text-accent text-xs">
								{String(idx + 1).padStart(2, "0")}
							</span>
							<span class="flex-1">
								<span class="block font-medium group-hover:text-accent">
									{chapter.data.title}
								</span>
								{
									chapter.data.description && (
										<span class="block text-dim text-sm">
											{chapter.data.description}
										</span>
									)
								}
							</span>
							<time
								datetime={chapter.data.date.toISOString()}
								class="font-mono text-dim text-xs"
							>
								{formatDate(chapter.data.date)}
							</time>
						</a>
					</li>
				))
			}
		</ol>
	</div>
</Layout>